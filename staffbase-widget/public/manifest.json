{
  "id": "kroger-division-video-v12",
  "version": "1.0.0",
  "name": "Kroger Video",
  "description": "Video picker widget for Kroger division videos powered by Qumu. Lets editors browse, search, and embed division-specific videos directly inside Staffbase articles.",
  "author": "Kroger",
  "blocks": [
    {
      "id": "kroger-division-video-v12",
      "name": "Kroger Video",
      "source": "kroger-video-widget.js",
      "configurationSchema": {
        "$schema": "http://json-schema.org/draft-07/schema",
        "type": "object",
        "properties": {
          "division":      { "type": "string", "title": "Division"    },
          "videotitle":    { "type": "string", "title": "Video Title" },
          "videourl":      { "type": "string", "title": "Video URL"   },
          "videoduration": { "type": "string", "title": "Duration"    },
          "videoexpiry":   { "type": "string", "title": "Expiry Date" },
          "videothumb":    { "type": "string", "title": "Thumbnail"   }
        }
      },
      "uiSchema": {
        "division":      { "ui:widget": "hidden" },
        "videotitle":    { "ui:widget": "hidden" },
        "videourl":      { "ui:widget": "hidden" },
        "videoduration": { "ui:widget": "hidden" },
        "videoexpiry":   { "ui:widget": "hidden" },
        "videothumb":    { "ui:widget": "hidden" }
      }
    },
    {
      "id": "kroger-stockquote",
      "name": "Kroger Stock Quote",
      "source": "kroger-stockquote.js",
      "configurationSchema": {
        "$schema": "http://json-schema.org/draft-07/schema",
        "type": "object",
        "properties": {}
      },
      "uiSchema": {}
    },
    {
      "id": "kroger-qualtrics-feedback",
      "name": "Qualtrics Embedded Feedback",
      "source": "kroger-qualtrics-feedback.js",
      "configurationSchema": {
        "$schema": "http://json-schema.org/draft-07/schema",
        "title": "Qualtrics Embedded Feedback",
        "type": "object",
        "properties": {}
      },
      "uiSchema": {}
    },
    {
      "id": "kroger-pingone-auth",
      "name": "Kroger PingOne Auth",
      "source": "kroger-pingone-auth.js",
      "configurationSchema": {
        "$schema": "http://json-schema.org/draft-07/schema",
        "title": "Kroger PingOne Auth",
        "description": "Silent PingOne authentication plugin. Add once to the global page layout — it handles token acquisition and makes the token available to all other Kroger widgets on the page. Renders nothing when the user is signed in.",
        "type": "object",
        "properties": {}
      },
      "uiSchema": {}
    }
  ]
}
